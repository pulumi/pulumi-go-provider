{
  "name": "go-components",
  "version": "0.1.0",
  "namespace": "examples",
  "language": {
    "csharp": {
      "respectSchemaVersion": true
    },
    "go": {
      "generateResourceContainerTypes": true,
      "importBasePath": "github.com/examples/go-components/sdk/go/go-components",
      "respectSchemaVersion": true
    },
    "nodejs": {
      "respectSchemaVersion": true
    },
    "python": {
      "pyproject": {
        "enabled": true
      },
      "respectSchemaVersion": true
    }
  },
  "config": {},
  "resources": {
    "go-components:index:RandomComponent": {
      "properties": {
        "hardcodedOutput": {
          "type": "string"
        },
        "length": {
          "type": "integer",
          "description": "You can add comments to input fields"
        },
        "password": {
          "$ref": "/random/v4.8.1/schema.json#/resources/random:index/randomPassword:RandomPassword",
          "description": "You can add comments to resource properties"
        }
      },
      "required": [
        "length",
        "password",
        "hardcodedOutput"
      ],
      "inputProperties": {
        "length": {
          "type": "integer",
          "description": "You can add comments to input fields"
        }
      },
      "requiredInputs": [
        "length"
      ],
      "isComponent": true
    },
    "go-components:nested:NestedRandomComponent": {
      "properties": {
        "hardcodedOutput": {
          "type": "string"
        },
        "length": {
          "type": "integer"
        },
        "password": {
          "$ref": "/random/v4.8.1/schema.json#/resources/random:index/randomPassword:RandomPassword"
        }
      },
      "required": [
        "length",
        "password",
        "hardcodedOutput"
      ],
      "inputProperties": {
        "length": {
          "type": "integer"
        }
      },
      "requiredInputs": [
        "length"
      ],
      "isComponent": true
    }
  }
}
