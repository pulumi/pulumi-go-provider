{
  "name": "dna-store",
  "version": "0.1.0",
  "namespace": "examples",
  "language": {
    "csharp": {
      "respectSchemaVersion": true
    },
    "go": {
      "generateResourceContainerTypes": true,
      "importBasePath": "github.com/examples/dna-store/sdk/go/dna-store",
      "respectSchemaVersion": true
    },
    "nodejs": {
      "respectSchemaVersion": true
    },
    "python": {
      "pyproject": {
        "enabled": true
      },
      "respectSchemaVersion": true
    }
  },
  "config": {},
  "types": {
    "dna-store:index:Metadata": {
      "properties": {
        "sampleType": {
          "$ref": "#/types/dna-store:index:SampleType",
          "description": "sample type of the dna"
        },
        "tags": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "optional tags associated with the dna sample"
        }
      },
      "type": "object",
      "required": [
        "sampleType"
      ]
    },
    "dna-store:index:Molecule": {
      "type": "integer",
      "enum": [
        {
          "name": "A",
          "description": "adenine",
          "value": 0
        },
        {
          "name": "C",
          "description": "cytosine",
          "value": 1
        },
        {
          "name": "T",
          "description": "thymine",
          "value": 2
        },
        {
          "name": "G",
          "description": "guanine",
          "value": 3
        }
      ]
    },
    "dna-store:index:SampleType": {
      "type": "string",
      "enum": [
        {
          "name": "human",
          "value": "human"
        },
        {
          "name": "dog",
          "value": "dog"
        },
        {
          "name": "cat",
          "value": "cat"
        },
        {
          "name": "other",
          "value": "other"
        }
      ]
    }
  },
  "resources": {
    "dna-store:index:DNAStore": {
      "properties": {
        "data": {
          "type": "array",
          "items": {
            "$ref": "#/types/dna-store:index:Molecule"
          },
          "description": "molecule data"
        },
        "filedir": {
          "type": "string"
        },
        "metadata": {
          "$ref": "#/types/dna-store:index:Metadata",
          "description": "stores information related to a particular dna"
        }
      },
      "required": [
        "data",
        "filedir",
        "metadata"
      ],
      "inputProperties": {
        "data": {
          "type": "array",
          "items": {
            "$ref": "#/types/dna-store:index:Molecule"
          },
          "description": "molecule data"
        },
        "filedir": {
          "type": "string"
        },
        "metadata": {
          "$ref": "#/types/dna-store:index:Metadata",
          "description": "stores information related to a particular dna"
        }
      },
      "requiredInputs": [
        "data",
        "filedir",
        "metadata"
      ]
    }
  }
}
