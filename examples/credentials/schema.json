{
  "name": "credentials",
  "version": "0.1.0",
  "namespace": "examples",
  "language": {
    "csharp": {
      "respectSchemaVersion": true
    },
    "go": {
      "generateResourceContainerTypes": true,
      "importBasePath": "github.com/examples/credentials/sdk/go/credentials",
      "respectSchemaVersion": true
    },
    "nodejs": {
      "respectSchemaVersion": true
    },
    "python": {
      "pyproject": {
        "enabled": true
      },
      "respectSchemaVersion": true
    }
  },
  "config": {
    "variables": {
      "hash": {
        "$ref": "#/types/credentials:index:HashKind",
        "description": "The (entirely uncryptographic) hash function used to encode the \"password\".",
        "default": "Adler32"
      },
      "password": {
        "type": "string",
        "description": "The password. It is very secret.",
        "default": "",
        "defaultInfo": {
          "environment": [
            "FOO"
          ]
        },
        "secret": true
      },
      "user": {
        "type": "string",
        "description": "The username. Its important but not secret."
      }
    },
    "defaults": [
      "user",
      "hash"
    ]
  },
  "types": {
    "credentials:index:HashKind": {
      "type": "string",
      "enum": [
        {
          "description": "Adler32 implements the Adler-32 checksum.",
          "value": "Adler32"
        },
        {
          "description": "CRC32 implements the 32-bit cyclic redundancy check, or CRC-32, checksum.",
          "value": "CRC32"
        }
      ]
    }
  },
  "provider": {
    "properties": {
      "hash": {
        "$ref": "#/types/credentials:index:HashKind",
        "description": "The (entirely uncryptographic) hash function used to encode the \"password\".",
        "default": "Adler32"
      },
      "password": {
        "type": "string",
        "description": "The password. It is very secret.",
        "default": "",
        "defaultInfo": {
          "environment": [
            "FOO"
          ]
        },
        "secret": true
      },
      "user": {
        "type": "string",
        "description": "The username. Its important but not secret."
      }
    },
    "required": [
      "user",
      "password",
      "hash"
    ],
    "inputProperties": {
      "hash": {
        "$ref": "#/types/credentials:index:HashKind",
        "description": "The (entirely uncryptographic) hash function used to encode the \"password\".",
        "default": "Adler32"
      },
      "password": {
        "type": "string",
        "description": "The password. It is very secret.",
        "default": "",
        "defaultInfo": {
          "environment": [
            "FOO"
          ]
        },
        "secret": true
      },
      "user": {
        "type": "string",
        "description": "The username. Its important but not secret."
      }
    },
    "requiredInputs": [
      "user",
      "hash"
    ]
  },
  "resources": {
    "credentials:index:User": {
      "properties": {
        "name": {
          "type": "string"
        },
        "password": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "password"
      ]
    }
  },
  "functions": {
    "credentials:index:sign": {
      "description": "Signs the message with the user name and returns the result as a secret.",
      "inputs": {
        "properties": {
          "message": {
            "type": "string",
            "description": "Message to sign."
          }
        },
        "type": "object",
        "required": [
          "message"
        ]
      },
      "outputs": {
        "properties": {
          "out": {
            "secret": true,
            "type": "string"
          }
        },
        "required": [
          "out"
        ],
        "type": "object"
      }
    }
  }
}
